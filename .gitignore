# Local development only - not part of the submission
.venv-harness/
.harness/
.verify_build/
__pycache__/
*.pyc

# Kaggle run artefacts - regenerate with `kaggle kernels output`
kaggle_work/*/runs/

# Large vendored competition data - re-download with `kaggle competitions download`
kaggle_work/*/research/wheelhouse/
kaggle_work/*/research/files_all.txt
kaggle_work/*/research/wheelhouse_files.txt
kaggle_work/*/research/pulled/**/*.ipynb
kaggle_work/*/research/competition/tasks.jsonl
kaggle_work/*/research/competition/*.zip
# Generated notebook output - rebuild with `python tools/build_notebook.py`
build/

# Audit snapshots - 786 MB compressed / ~1.6 GB extracted, re-downloadable.
# See docs/AUDIT_SNAPSHOTS.md for the manifest, usage audit and retention policy.
audit_snapshots/
